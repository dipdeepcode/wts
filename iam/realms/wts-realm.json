{
  "enabled": true,
  "realm": "$(env:KC_REALM_NAME)",
  "clients": [
    {
      "clientId": "$(env:GATEWAY_CLIENT_ID)",
      "name": "$(env:KC_REALM_NAME) application",
      "rootUrl": "$(env:FRONTEND_URL)",
      "adminUrl": "$(env:FRONTEND_URL)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:GATEWAY_CLIENT_SECRET)",
      "redirectUris": [
        "/*"
      ],
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "post.logout.redirect.uris": "/*",
        "use.refresh.tokens": "true",
        "backchannel.logout.url": "http://gateway:8080/logout/connect/back-channel/keycloak",
        "backchannel.logout.session.required": "true",
        "client_credentials.use_refresh_token": "false",
        "require.pushed.authorization.requests": "false",
        "pkce.code.challenge.method": "S256",
        "id.token.as.detached.signature": "false",
        "logout.confirmation.enabled": "false",
        "client.introspection.response.allow.jwt.claim.enabled": "false",
        "client.use.lightweight.access.token.enabled": "false",
        "request.object.required": "not required",
        "access.token.header.type.rfc9068": "false",
        "acr.loa.map": "{}",
        "tls.client.certificate.bound.access.tokens": "false",
        "display.on.consent.screen": "false",
        "token.response.type.bearer.lower-case": "false"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "DEBUGGER",
        "description": "",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      }
    ]
  },
  "scopeMappings": [
    {
      "clientScope": "roles",
      "roles": [
        "DEBUGGER"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "protocolMappers": [
        {
          "name": "realm roles",
          "config": {
            "multivalued": "true",
            "id.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}