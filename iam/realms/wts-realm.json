{
  "enabled": true,
  "realm": "$(env:KC_REALM_NAME)",
  "clients": [
    {
      "clientId": "$(env:GATEWAY_CLIENT_ID)",
      "name": "$(env:KC_REALM_NAME) application",
      "rootUrl": "$(env:FRONTEND_URL)",
      "adminUrl": "$(env:FRONTEND_URL)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "secret": "$(env:GATEWAY_CLIENT_SECRET)",
      "redirectUris": [
        "/*"
      ],
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "attributes": {
        "post.logout.redirect.uris": "/*",
        "use.refresh.tokens": "true",
        "backchannel.logout.url": "http://gateway:8080/logout/connect/back-channel/keycloak",
        "backchannel.logout.session.required": "true",
        "client_credentials.use_refresh_token": "false",
        "require.pushed.authorization.requests": "false",
        "pkce.code.challenge.method": "S256",
        "id.token.as.detached.signature": "false",
        "logout.confirmation.enabled": "false",
        "client.introspection.response.allow.jwt.claim.enabled": "false",
        "client.use.lightweight.access.token.enabled": "false",
        "request.object.required": "not required",
        "access.token.header.type.rfc9068": "false",
        "acr.loa.map": "{}",
        "tls.client.certificate.bound.access.tokens": "false",
        "display.on.consent.screen": "false",
        "token.response.type.bearer.lower-case": "false"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "id_token_roles"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "tasks-service-api",
        "organization",
        "microprofile-jwt"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "DEBUGGER",
        "description": "",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      }
    ]
  },
  "clientScopes": [
    {
      "name": "id_token_roles",
      "description": "OpenID Connect scope for add user roles to the ID token",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "tasks-service-api",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience for tasks-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "included.custom.audience": "tasks-service"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "id_token_roles",
      "roles": [
        "DEBUGGER"
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "saml_organization",
    "AuthnContextClassRef",
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "basic"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt",
    "organization",
    "id_token_roles",
    "tasks-service-api"
  ]
}
